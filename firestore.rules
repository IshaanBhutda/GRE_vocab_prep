rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public rankings: anyone can read; each signed-in player writes only their own row.
    match /players/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly(['nick', 'name', 'photo', 'sets', 'updatedAt'])
                   && request.resource.data.nick is string && request.resource.data.nick.size() <= 24
                   && request.resource.data.sets is map;
    }

    // Private flashcard progress: only the owner can read or write it.
    match /progress/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Words added by players: anyone reads; signed-in players add; only the author deletes.
    match /custom/{id} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.by == request.auth.uid
                    && request.resource.data.w is string && request.resource.data.w.size() > 0 && request.resource.data.w.size() <= 40
                    && request.resource.data.d is string && request.resource.data.d.size() > 0 && request.resource.data.d.size() <= 200;
      allow delete: if request.auth != null && resource.data.by == request.auth.uid;
    }
  }
}
